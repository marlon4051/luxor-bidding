datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  bids Bid[]
  collections Collection[]
}

model Collection {
  id String @id @default(uuid())
  name String
  description String
  stocks Int
  price Float
  userId String
  user User @relation(fields: [userId], references: [id])
  bids Bid[]
}

model Bid {
  id String @id @default(uuid())
  price Float
  status BidStatus
  collectionId String
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id])
}

enum BidStatus {
  pending
  accepted
  rejected
}
